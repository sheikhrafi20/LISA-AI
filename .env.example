# Copy this file to .env and choose ONE way to turn AI on. Never commit .env.

# Option 1 (free, runs on your own computer): Ollama
# First install Ollama from https://ollama.com and run: ollama pull llama3.2
LISA_PROVIDER=ollama
# LISA_MODEL=llama3.2
# OLLAMA_HOST=http://localhost:11434

# Option 2 (paid): Anthropic API. Remove the LISA_PROVIDER line above first.
# ANTHROPIC_API_KEY=your-api-key-here
# LISA_MODEL=claude-haiku-5-5
