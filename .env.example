# LISA settings (optional). Copy this file to .env and remove the # in front of a line to use it.
# LISA does not need any of these: the defaults work with Ollama on this computer.

# Which Ollama model to use (run `ollama pull <name>` once first)
# LISA_MODEL=llama3.2

# Where Ollama is running
# OLLAMA_HOST=http://localhost:11434

# Longest reply, and how many recent messages LISA remembers in one chat
# LISA_MAX_TOKENS=600
# LISA_HISTORY=20
